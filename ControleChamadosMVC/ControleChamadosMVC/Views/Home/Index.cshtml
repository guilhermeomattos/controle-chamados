@{
    ViewData["Title"] = "Página Inicial";
}

<div class="text-center">
    <h1 class="display-4 fw-bold">Sistema de Controle de Chamados</h1>
    <p class="text-muted">Utilize os cards abaixo para gerenciar o sistema.</p>
    <hr class="w-25 mx-auto mb-5" />

    <div class="row justify-content-center">

        <div class="col-md-3 mb-4">
            <div class="card bg-transparent shadow-sm border rounded-4 h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill display-4 text-primary mb-3"></i>
                    <h5 class="card-title fw-semibold">Usuários</h5>
                    <a class="btn btn-outline-primary w-100 mt-2"
                       asp-controller="Usuario"
                       asp-action="Index">
                        Gerenciar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card bg-transparent shadow-sm border rounded-4 h-100">
                <div class="card-body text-center">
                    <i class="bi bi-list-task display-4 text-primary mb-3"></i>
                    <h5 class="card-title fw-semibold">Chamados</h5>
                    <a class="btn btn-outline-primary w-100 mt-2"
                       asp-controller="Chamado"
                       asp-action="Index">
                        Gerenciar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card bg-transparent shadow-sm border rounded-4 h-100">
                <div class="card-body text-center">
                    <i class="bi bi-inbox display-4 text-primary mb-3"></i>
                    <h5 class="card-title fw-semibold">Novo Chamado</h5>
                    <a class="btn btn-outline-primary w-100 mt-2"
                       asp-controller="Chamado"
                       asp-action="Create">
                        Criar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
