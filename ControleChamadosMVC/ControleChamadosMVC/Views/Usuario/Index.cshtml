@model List<ControleChamadosMVC.Models.UsuarioViewModel>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Listagem de Usuários";
}

<h2>Listagem de Usuários</h2>
<a href="/usuario/create" class="btn btn-success">Novo Registro</a>
    <a href="/home/index" class="btn btn-secondary">Voltar</a>
<br />
<br />

<table class="table table-striped table-responsive">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th style="width: 150px;">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Id</td>
                <td>@usuario.Nome</td>
                <td>
                    <a href="/usuario/Edit?id=@usuario.Id" class="btn btn-primary btn-sm me-2">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a href="javascript:apagarUsuario(@usuario.Id)" class="btn btn-danger btn-sm">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    function apagarUsuario(id) {
        Swal.fire({
            title: 'Tem certeza?',
            text: "Essa ação não poderá ser desfeita!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sim, apagar!',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/usuario/delete?id=' + id;
            }
        });
    }
</script>
