@model ControleChamadosMVC.Models.UsuarioViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cadastro de Usuário";
}

<h2>Cadastro de Usuário</h2>

<br />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Save" method="post">
            <input type="hidden" name="Operacao" value="@ViewBag.Operacao" />

            <div class="form-group">
                <label for="Id" class="control-label">Código</label>

                @if (ViewBag.Operacao == "A")
                {
                    <input asp-for="Id" class="form-control" readonly />
                }
                else
                {
                    <input asp-for="Id" class="form-control" />
                }
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label for="Nome" class="control-label">Nome</label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-success" />
                &nbsp;
                <a href="/usuario/index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>