@model List<ControleChamadosMVC.Models.ChamadoViewModel>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Listagem de Chamados";
}

<h2>Listagem de Chamados</h2>
<a href="/home/index" class="btn btn-secondary">Voltar</a>
<br />
<br />

<table class="table table-striped table-responsive">
    <thead>
        <tr>            
            <th>Código</th>
            <th>Descrição do Problema</th>
            <th>Situação</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var chamado in Model)
        {
            <tr>
                <td>@chamado.Id</td>
                <td>@chamado.DescricaoProblema</td>
                <td>
                    @(chamado.Situacao == 1 ? "Pendente" : "Atendido")
                </td>
                <td>
                    <a href="/chamado/Edit?id=@chamado.Id" class="btn btn-primary btn-sm me-2">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a href="javascript:apagarUsuario(@chamado.Id)" class="btn btn-danger btn-sm me-2">
                        <i class="bi bi-x-lg"></i>
                    </a>
                    @if (chamado.Situacao == 1){
                        <a href="/chamado/Atender?id=@chamado.Id" class="btn btn-success btn-sm me-2">
                            <i class="bi bi-headset"></i>
                        </a>
                    }                   
                </td>                                     
            </tr>
        }
    </tbody>
</table>

<script>
    function apagarUsuario(id) {
        if (confirm('Confirma a exclusão do registro?'))
            location.href = '/chamado/delete?id=' + id;
    }
</script>