@model ControleChamadosMVC.Models.ChamadoViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cadastro de Chamado";
}

<h2>Atender Chamado</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Save" method="post">
            <input type="hidden" name="Operacao" value="@ViewBag.Operacao" />

            <div class="form-group">
                <label for="Id" class="control-label">Código</label>

                @if (ViewBag.Operacao == "AT")
                {
                    <input asp-for="Id" class="form-control" readonly />
                }
                else
                {
                    <input asp-for="Id" class="form-control" />
                }
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group">
                <label for="DataAbertura" class="control-label">Data de Abertura</label>
                <input asp-for="DataAbertura" class="form-control" type="date" readonly />
                <span asp-validation-for="DataAbertura" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group">
                <label for="DescricaoProblema" class="control-label">Descrição Problema</label>
                <input asp-for="DescricaoProblema" class="form-control" readonly />
                <span asp-validation-for="DescricaoProblema" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group">
                <label for="DescricaoAtendimento" class="control-label">Descrição do Atendimento</label>
                <textarea asp-for="DescricaoAtendimento" class="form-control"></textarea>
                <span asp-validation-for="DescricaoAtendimento" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group">
                <label for="DataAtendimento" class="control-label">Data de Atendimento</label>
                <input asp-for="DataAtendimento" class="form-control" type="date" />
                <span asp-validation-for="DataAtendimento" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group">
                <label for="Situacao" class="control-label">Situação</label>
                <select asp-for="Situacao" class="form-control">
                    <option value="1">Pendente</option>
                    <option value="2">Atendido</option>
                </select>
                <span asp-validation-for="Situacao" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group">
                <label for="UsuarioId" class="control-label">Usuário</label>
                <select asp-for="UsuarioId" class="form-control" asp-items="ViewBag.Usuarios">
                    <option value="">-- Selecione --</option>
                </select>
                <span asp-validation-for="UsuarioId" class="text-danger"></span>
            </div>
            <br />


            <br />

            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-success" />
                &nbsp;
                <a href="/chamado/index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>